<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".LocalAgentApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="LocalAgent"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAgent">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CurrentObservationActivity"
            android:exported="true"
            android:label="Current UI Observation" />

        <activity
            android:name=".ui.ExternalObservationActivity"
            android:exported="true"
            android:label="External Application Observation" />

        <activity
            android:name=".ui.EvidenceActivity"
            android:exported="true"
            android:label="Evidence Diagnostics" />

        <activity
            android:name=".ui.PermissionActivity"
            android:exported="true"
            android:label="Permission Center" />

        <activity
            android:name=".ui.ObservationActivity"
            android:exported="true"
            android:label="Observation Screen" />

        <activity
            android:name=".ui.EventLogActivity"
            android:exported="true"
            android:label="Pipeline Event Log" />

        <activity
            android:name=".ui.StorageDiagnosticsActivity"
            android:exported="true"
            android:label="Storage Diagnostics" />

        <service
            android:name=".accessibility.AgentAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
