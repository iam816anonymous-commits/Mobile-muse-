<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LocalAgent Diagnostic Test UI (Phase 2)"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEventStorageHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="EVENT STORAGE (App-Private Operational DB):"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#004D40" />

    <TextView
        android:id="@+id/tvEventStorageDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="DB Name: agent.db | Location: APP_PRIVATE\nSession: ... | Events: 0 | DB Size: 0 KB"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvDurableMemoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="LONG-TERM MEMORY (User-Owned Durable Storage):"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#1B5E20" />

    <TextView
        android:id="@+id/tvDurableMemoryDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Location: INTERNAL_SHARED_STORAGE (/sdcard/LocalAgent/memory/)\nStatus: INITIALIZING... | Records: 0 | Persistence: USER_OWNED"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/etCommandInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Enter command (e.g., click 7, observe, status)"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExecute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Execute" />

        <Button
            android:id="@+id/btnObserve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Observe" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLatestResultHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Latest Result:"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLatestResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="None"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvRecentEventsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Recent Pipeline Event Log (Hydrated from DB):"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvRecentEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No events recorded."
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
