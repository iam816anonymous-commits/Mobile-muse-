<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LocalAgent Home &amp; System Status"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAgentStatusHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="SYSTEM &amp; CAPABILITY STATUS:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#4A148C" />

    <TextView
        android:id="@+id/tvSystemStatusSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Agent Core: ACTIVE (API 27 Baseline)\nAccessibility Service: SERVICE_UNBOUND\nOperational Storage: agent.db (APP_PRIVATE)\nDurable Storage: /sdcard/LocalAgent/memory/"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvNavigationHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="SUBSYSTEM SCREENS:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#004D40" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpenPermissionCenterScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Permission Center"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnOpenObservationScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="UI Observation Screen"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpenEvidenceScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Evidence Diagnostics"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnOpenEventLogScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Event Log"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpenStorageDiagnosticsScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Storage &amp; Memory"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCommandHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="COMMAND CONSOLE INPUT:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#1B5E20" />

    <EditText
        android:id="@+id/etCommandInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:hint="Enter command (e.g., status, observe, click 7)"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExecute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Execute Command"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnToggleFloatingConsole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Floating Console"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLatestResultHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Latest Execution Result:"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvLatestResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="None"
        android:textSize="11sp"
        android:fontFamily="monospace" />

</LinearLayout>
