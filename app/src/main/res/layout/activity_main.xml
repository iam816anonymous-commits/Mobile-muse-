<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LocalAgent Diagnostic Test UI (Phase 3.1)"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAccessibilityHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ACCESSIBILITY SERVICE STATUS (Phase 3.1):"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#4A148C" />

    <TextView
        android:id="@+id/tvAccessibilityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Status: SERVICE_UNBOUND | Active Pkg: None"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvCurrentObservationDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Current Snapshot: None"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="#000080" />

    <TextView
        android:id="@+id/tvLastExternalObservationDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Last External Snapshot: None"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="#004D40" />

    <Button
        android:id="@+id/btnOpenAccessibilitySettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Open Accessibility Settings"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvEventStorageHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="EVENT STORAGE (App-Private DB):"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#004D40" />

    <TextView
        android:id="@+id/tvEventStorageDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="DB: agent.db | Events: 0 | DB Size: 0 KB"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvDurableMemoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="LONG-TERM MEMORY (Internal Shared Storage):"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#1B5E20" />

    <TextView
        android:id="@+id/tvDurableMemoryDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Location: /sdcard/LocalAgent/memory/ | Status: READY"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEnableStorage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable Storage"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnTestWriteMemory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Test Write Memory"
            android:textSize="10sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etCommandInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Enter command (e.g., observe, status, click 7)"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExecute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Execute" />

        <Button
            android:id="@+id/btnObserve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Observe UI" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLatestResultHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Latest Result:"
        android:textStyle="bold"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvLatestResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="None"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvRecentEventsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Recent Pipeline Event Log (Scrollable Stream):"
        android:textStyle="bold"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/scrollEventLogContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvRecentEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No events recorded."
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical" />
    </ScrollView>

</LinearLayout>
