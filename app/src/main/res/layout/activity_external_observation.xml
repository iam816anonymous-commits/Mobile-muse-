<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EXTERNAL APP OBSERVATION"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000080" />

    <TextView
        android:id="@+id/tvAccessibilityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Status: SERVICE_UNBOUND | Active Pkg: None"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#4A148C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpenPermissionCenter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Permission Center"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnCaptureExternalUi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Capture External UI"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDiagnosticsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="WINDOW SELECTION DIAGNOSTICS:"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDiagnosticsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Foreground Package: None\nValidated Target: None\nLast Valid External Package: None"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:background="#FFF3E0"
        android:padding="4dp" />

    <TextView
        android:id="@+id/tvExternalSnapshotMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Package: None | Nodes: 0 | Depth: 0 | Truncated: false"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:background="#E8EAF6"
        android:padding="4dp" />

    <TextView
        android:id="@+id/tvExternalTreeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="LAST VALID EXTERNAL APP NODE TREE:"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:fillViewport="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvExternalNodeTree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No valid external tree captured."
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>
