<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unified UI Observation Screen"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAccessibilityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Status: SERVICE_UNBOUND | Target Pkg: None | Foreground: None"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#4A148C" />

    <!-- VIEW SELECTION TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnViewLiveScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="View A: Live"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnViewExternalScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="View B: External"
            android:textSize="9sp" />

        <Button
            android:id="@+id/btnViewActionPair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="View C: Action Pair"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnObserveUi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Refresh Capture"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnClearObservation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Clear Display"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnOpenAccessibilitySettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="A11y Settings"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- WINDOW SELECTION DIAGNOSTICS SECTION -->
    <TextView
        android:id="@+id/tvDiagnosticsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="WINDOW &amp; TARGET SELECTION DIAGNOSTICS:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#880E4F" />

    <TextView
        android:id="@+id/tvDiagnosticsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Foreground Package: None\nAvailable Windows: None\nSelected Target Window: None"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="#263238"
        android:background="#F5F5F5"
        android:padding="4dp" />

    <TextView
        android:id="@+id/tvSnapshotHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="TARGET OBSERVATION SNAPSHOT:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#000080" />

    <TextView
        android:id="@+id/tvSnapshotMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Package: None | Nodes: 0 | Depth: 0 | Truncated: false | Timestamp: 0"
        android:textSize="10sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvNodeTreeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Accessible Element Hierarchy (Indented Tree):"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- SINGLE TREE CONTAINER (FOR VIEW A & VIEW B) -->
    <ScrollView
        android:id="@+id/scrollSingleTree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvNodeTree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No observation captured."
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- ACTION PAIR CONTAINER (FOR VIEW C: PRE vs POST) -->
    <LinearLayout
        android:id="@+id/layoutActionPairContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- PANEL A: PRE-ACTION TREE -->
        <TextView
            android:id="@+id/tvPreHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL A — PRE-ACTION TREE:"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

        <ScrollView
            android:id="@+id/scrollPreNodeTree"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="1dp"
            android:background="#F1F8E9"
            android:padding="4dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvPreNodeTree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No pre-action snapshot captured."
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </ScrollView>

        <!-- PANEL B: POST-ACTION TREE -->
        <TextView
            android:id="@+id/tvPostHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="PANEL B — POST-ACTION TREE:"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#0D47A1" />

        <ScrollView
            android:id="@+id/scrollPostNodeTree"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="1dp"
            android:background="#E3F2FD"
            android:padding="4dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvPostNodeTree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No post-action snapshot captured."
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
