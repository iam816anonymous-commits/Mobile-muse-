<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LocalAgent Pipeline Event Log"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEventLogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="PERSISTENT EVENT HISTORY (agent.db):"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#004D40" />

    <TextView
        android:id="@+id/tvEventLogStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Total Events: 0 | DB Size: 0 KB"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#333333" />

    <ScrollView
        android:id="@+id/scrollEventLogContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvEventLogStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No events recorded in database."
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
